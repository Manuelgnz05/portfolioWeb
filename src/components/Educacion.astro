---
// src/components/Educacion.astro
import json from "../data/educacion.json";
import Estudio from "./Estudio.astro";
---

<section id="educacion">
  <div class="educacion-wrapper">
    <h2>EDUCACIÓN</h2>
    
    <div class="timeline-container">
      <div class="timeline-line"></div>

      {json.map((contenido) => (
        <Estudio json={contenido} />
      ))}

      <div class="initial-commit-container">
        <div class="commit-pill">
          <img src="public/commit.png" alt="commit icon" class="icon-commit" />
          <span>Initial Commit (Hello World)</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 60px 0px;
    margin-top: 100px;
    background-color: #E0E0E0;
  }

  .educacion-wrapper {
    width: 100%;
    max-width: 1180px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  h2 {
    font-size: 32px;
    font-weight: 700;
    color: #434343;
    letter-spacing: 2px;
    margin: 0px 0px 80px 0px;
    text-transform: uppercase;
  }

  .timeline-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .timeline-line {
    position: absolute;
    top: 0px;
    bottom: 40px;
    width: 2px;
    background-color: #AAB888;
  }

  .initial-commit-container {
    margin-top: 20px;
  }

  .commit-pill {
    background-color: #434343;
    color: #E0E0E0;
    padding: 12px 30px;
    border-radius: 25px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    height: 40px;
    width: 270px;
    font-size: 11px;
    font-weight: 500;
    box-shadow: 0px 6px 15px rgba(0, 0, 0, 0.2);
    transition: all 0.3s ease;
    cursor: pointer;
    outline: 2px solid transparent;
  }


    .commit-pill:hover {
        outline: 2px solid #AAB888;
        color: #AAB888;
        box-shadow: 0px 6px 20px rgba(139, 155, 130, 0.3);
    }

    .icon-commit {
        width: 25px;
        height: 13px;
    }

    .commit-pill:hover .icon-commit {
      filter: brightness(0) saturate(100%) invert(81%) sepia(21%) saturate(629%) hue-rotate(54deg) brightness(91%) contrast(85%);
    }

  
</style>