---
const { json } = Astro.props;
---

<div class="skill-wrapper" data-percentage={json.percentage}>
  <div 
    class="skill-card" 
    style={`background-image: linear-gradient(180deg, ${json.color} 0%, var(--bg-main) 100%);`}
  >
    <img class="skill-logo" src={json.icon} alt={json.name} />
    <span>{json.name}</span>
  </div>

  <div class="progress-container">
    <div class="progress-track">
      <div class="progress-fill" style={`background-color: ${json.color};`}></div>
    </div>
    <span class="progress-text">0%</span>
  </div>
</div>

<style>
  .skill-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .skill-card {
    width: 280px;
    height: 150px;
    background-color: var(--bg-main);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 30px;
    box-shadow: 0px 4px 100px 15px rgba(0, 0, 0, 0.25);
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }

  :global(body.dark-theme) .skill-card {
    box-shadow: 0px 4px 100px 15px rgba(0, 0, 0, 0.6);
  }

  img {
    width: 80px;
    height: 80px;
    object-fit: contain;
  }

  span {
    font-size: 30px;
    font-weight: 500;
    color: var(--text-title);
    letter-spacing: 0.5px;
    transition: color 0.3s ease;
  }

  .progress-container {
    display: flex;
    align-items: center;
    gap: 15px;
    width: 90%; 
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease;
  }

  .skill-wrapper:hover .progress-container {
    opacity: 1;
    visibility: visible;
  }

  .progress-track {
    flex: 1;
    height: 14px;
    background-color: var(--bg-main);
    border: 1px solid var(--nav-border);
    border-radius: 15px;
    overflow: hidden;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .progress-fill {
    height: 100%;
    width: 0%; 
    border-radius: 15px;
    transition: width 0.8s ease-out; 
  }

  .progress-text {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-title);
    min-width: 35px;
    text-align: right;
    transition: color 0.3s ease;
  }
  :global(body.dark-theme) .skill-logo {
    filter: invert(1);
  }
</style>

<script>
  const wrappers = document.querySelectorAll('.skill-wrapper');

  wrappers.forEach(wrapper => {
    const fill = wrapper.querySelector('.progress-fill') as HTMLElement;
    const text = wrapper.querySelector('.progress-text') as HTMLElement;
    
    const targetStr = wrapper.getAttribute('data-percentage');
    const target = targetStr ? parseInt(targetStr, 10) : 0;
    
    let interval: ReturnType<typeof setInterval>;

    wrapper.addEventListener('mouseenter', () => {
      if (fill) fill.style.width = target + '%';
      
      let current = 0;
      clearInterval(interval);
      
      const speed = target > 0 ? 800 / target : 0; 
      
      if (target > 0) {
        interval = setInterval(() => {
          if (current >= target) {
            clearInterval(interval);
            if (text) text.innerText = target + '%';
          } else {
            if (text) text.innerText = current + '%';
            current++;
          }
        }, speed);
      }
    });

    wrapper.addEventListener('mouseleave', () => {
      clearInterval(interval);
      if (fill) fill.style.width = '0%';
      if (text) text.innerText = '0%';
    });
  });
</script>