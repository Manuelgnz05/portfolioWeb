<button id="theme-toggle" class="theme-btn" aria-label="Cambiar tema">
  <span class="icon-sun">☀️</span>
  <span class="icon-moon">🌙</span>
</button>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('theme-toggle');
    const body = document.body;

    const savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'dark') {
      body.classList.add('dark-theme');
    }

    toggleBtn?.addEventListener('click', () => {
      body.classList.toggle('dark-theme');
      const isDark = body.classList.contains('dark-theme');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  });
</script>

<style>
  .theme-btn {
    position: fixed;
    bottom: 30px;
    right: 30px;
    z-index: 1000;

    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--card-bg);
    border: 2px solid var(--accent-color);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0px 6px 20px rgba(0, 0, 0, 0.35);
    transition: transform 0.25s ease, background-color 0.3s ease, box-shadow 0.25s ease;
  }

  .theme-btn:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0px 10px 25px rgba(0, 0, 0, 0.45);
  }

  .theme-btn:active {
    transform: translateY(-1px) scale(0.98);
  }

  .icon-sun,
  .icon-moon {
    font-size: 20px;
    line-height: 1;
  }

  .icon-moon {
    display: none;
  }

  :global(body.dark-theme) .icon-sun {
    display: none;
  }

  :global(body.dark-theme) .icon-moon {
    display: inline;
  }
</style>