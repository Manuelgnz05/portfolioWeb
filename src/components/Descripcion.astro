<section id="inicio">
  <article>
    <div class="imagen-box">
      <img src="perfil.png" alt="Fotografía de perfil" />
    </div>
    
    <div class="texto-box">
      <h2>Descripción</h2>
      <p>
        Soy un profesional con experiencia como profesor particular. Destaco por mi habilidad con el lenguaje Java y mis excepcionales habilidades de comunicación. Busco aplicar mi creatividad e ingenio en un entorno colaborativo.
      </p>
      
      <button class="link-contacto nav-trigger" data-target="#contacto" data-offset="0">
        Contacto
      </button>
    </div>
  </article>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btnContacto = document.querySelector('.btn-contacto, .link-contacto');

    if (btnContacto) {
      btnContacto.addEventListener('click', () => {
        const targetId = btnContacto.getAttribute('data-target');
        const customOffset = parseInt(btnContacto.getAttribute('data-offset') || '100', 10);

        if (targetId) {
          const targetElement = document.querySelector(targetId);
          if (targetElement) {
            const elementPosition = targetElement.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.pageYOffset - customOffset;

            window.scrollTo({
              top: offsetPosition,
              behavior: 'smooth'
            });
          }
        }
      });
    }
  });
</script>

<style>
