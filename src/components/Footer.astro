  h3 {
    font-size: 22px;
    font-weight: 700;
    color: #A4A4A4;
    margin: 0;
    letter-spacing: 0.5px;
  }

  .code-icon {
    color: #AAB888;
  }

  .tech-stack {
    font-size: 16px;
    color: #B5B5B5;
    margin: 0;
