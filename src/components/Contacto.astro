---
// src/components/Contacto.astro
---

<section id="contacto">
  <div class="wrapper">
    <h2>CONTACTO</h2>

    <div class="contact-container">
      
      <!-- Columna Izquierda: Formulario -->
      <div class="form-card">
        <h3 class="texto">Envía un mensaje</h3>
        <p class="subtitle">Se necesitan los tres campos, ya que la dirección de correo electrónico es la única forma de recibir una respuesta.</p>

        <form>
          <div class="input-row">
            <div class="input-group">
              <label for="nombre" class="texto">Tu nombre</label>
              <input type="text" id="nombre" placeholder="Manuel González" required />
            </div>
            <div class="input-group">
              <label for="email" class="texto">Correo electrónico</label>
              <input type="email" id="email" placeholder="you@example.com" required />
            </div>
          </div>

          <div class="input-group">
            <label for="mensaje" class="texto">Mensaje</label>
            <textarea id="mensaje" rows="3" placeholder="¿Qué tienes en mente? Si estás reportando un error, la URL de la página y tu navegador son de gran ayuda." required></textarea>
          </div>

          <button type="submit" class="submit-btn">
            Enviar mensaje
            <img src="envio.png" alt="Enviar" class="btn-icon" />
          </button>
        </form>

        <p class="footer-text">Sus datos se utilizarán únicamente para responderle. No se incluirán en ninguna lista de correo.</p>
      </div>

      <!-- Columna Derecha: Tarjetas de Información -->
      <div class="info-column">
        
        <!-- Tarjeta Email (Convertida en enlace mailto) -->
        <a href="mailto:manuelgoca08@gmail.com" class="info-card dark-card email-card">
          <div class="card-header small-header">
            <div class="icon-circle">
              <img src="correo-electronico.png" alt="Email" class="info-icon" />
            </div>
            <span>EMAIL</span>
          </div>
          <h4 class="email-title texto">manuelgoca08@gmail.com</h4>
          <p class="info-desc">La ruta más directa. Te lleva directamente a una persona.</p>
        </a>

        <!-- Fila de Redes Sociales -->
        <div class="social-row">
          
          <!-- Tarjeta GitHub (Convertida en enlace) -->
          <a href="https://github.com/manuelgnz05" target="_blank" rel="noopener noreferrer" class="info-card dark-card social-card">
            <img src="githud.png" alt="GitHub" class="social-icon" />
            <div class="social-text">
              <span class="social-title texto">GitHub</span>
              <span class="social-user">manuelgnz05</span>
            </div>
          </a>

          <!-- Tarjeta LinkedIn (Convertida en enlace) -->
          <a href="https://www.linkedin.com/in/manuel-gonz%C3%A1lez-caballero/" target="_blank" rel="noopener noreferrer" class="info-card dark-card social-card">
            <img src="/linkedin.png" alt="LinkedIn" class="social-icon" />
            <div class="social-text">
              <span class="social-title texto">LinkedIn</span>
              <span class="social-user">manuelgnz05</span>
            </div>
          </a>
        </div>

        <!-- Tarjeta Reportar Problema -->
        <div class="info-card light-card">
          <div class="card-header bold-header">
            <img src="globo-de-chat.png" alt="Reportar problema" class="info-icon" />
            <span>¿Quieres reportar un problema?</span>
          </div>
          <p class="info-desc dark-desc">Indica tu navegador y qué estabas haciendo en ese momento. Así se evita tener que volver a contactarte.</p>
        </div>

      </div>

    </div>
  </div>
</section>

<style>
  section {
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 80px 0px;
  }

  .wrapper {
    width: 100%;
    max-width: 1100px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  h2 {
    font-size: 32px;
    font-weight: 700;
    color: #434343;
    letter-spacing: 2px;
    margin: 0px 0px 40px 0px;
    text-transform: uppercase;
    text-shadow: 0px 4px 15px rgba(0, 0, 0, 0.15); 
  }

  .contact-container {
    display: flex;
    width: 100%;
    gap: 24px;
    align-items: stretch;
  }

  /* --- LADO IZQUIERDO: FORMULARIO --- */
  .form-card {
    flex: 1.4;
    background-color: #434343;
    border-radius: 20px;
    padding: 40px;
    box-shadow: 0px 25px 50px rgba(0, 0, 0, 0.45);
    display: flex;
    flex-direction: column;
  }

  .form-card h3 {
    font-size: 28px;
    margin: 0px 0px 10px 0px;
  }

  .subtitle {
    font-size: 15px;
    color: #B5B5B5;
    line-height: 1.4;
    margin: 0px 0px 20px 0px;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 30px;
  }

  .input-row {
    display: flex;
    gap: 20px;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 8px;
  }

  label {
    font-size: 15px;
    font-weight: 600;
  }

  input, textarea {
    background-color: #6E6E6E;
    border: none;
    border-radius: 12px;
    padding: 16px;
    font-family: inherit;
    font-size: 15px;
    color: #E0E0E0;
    box-shadow: 0px 12px 20px rgba(0, 0, 0, 0.35);
    resize: none;
  }

  input::placeholder, textarea::placeholder {
    color: #B5B5B5;
  }

  input:focus, textarea:focus {
    outline: 2px solid #AAB888;
  }

  .submit-btn {
    align-self: flex-start;
    background-color: #AAB888;
    color: #434343;
    border: none;
    border-radius: 25px;
    padding: 12px 24px;
    font-size: 16px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 5px;
    transition: background-color 0.2s;
    box-shadow: 0px 10px 20px rgba(0, 0, 0, 0.35);
  }

  .submit-btn:hover {
    background-color: #92a272; 
  }

  .btn-icon {
    width: 18px;
    height: 18px;
    object-fit: contain;
  }

  .footer-text {
    font-size: 12px;
    color: #B5B5B5;
    margin: auto 0px 0px 0px;
  }

  /* --- LADO DERECHO: TARJETAS --- */
  .info-column {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .info-card {
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0px 15px 30px rgba(0, 0, 0, 0.45);
    display: flex;
    flex-direction: column;
    justify-content: center;
    cursor: pointer;
    text-decoration: none; /* Evita el subrayado azul típico de los enlaces */
  }

  .dark-card {
    background-color: #434343;
    color: #E0E0E0;
    transition: outline 0.2s ease; 
  }

  .dark-card:hover {
    outline: 2px solid #AAB888;
  }

  .light-card {
    background-color: #EAEAEA;
    border: 1px solid #434343;
    color: #434343;
    box-shadow: 0px 15px 30px rgba(0, 0, 0, 0.25);
    text-decoration: none; /* Por si en el futuro decides que esta también sea un enlace */
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .small-header {
    font-size: 12px;
    color: #B5B5B5;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .icon-circle {
    width: 24px;
    height: 24px;
    border: 1px solid #B5B5B5;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bold-header {
    font-size: 16px;
    font-weight: 600;
    color: #434343;
  }

  .info-icon {
    width: 14px;
    height: 14px;
    object-fit: contain;
  }

  .light-card .info-icon {
    width: 20px;
    height: 20px;
  }

  .email-title {
    font-size: 20px;
    font-weight: 700;
    margin: 0px 0px 8px 0px;
  }

  .info-desc {
    font-size: 13px;
    color: #B5B5B5;
    line-height: 1.4;
    margin: 0px;
  }

  .dark-desc {
    color: #6E6E6E;
  }

  .social-row {
    display: flex;
    gap: 15px;
  }

  .social-card {
    flex: 1;
    gap: 12px;
    justify-content: flex-start;
  }

  .social-icon {
    width: 25px;
    height: 25px;
    object-fit: contain;
  }

  .social-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .social-title {
    font-size: 15px;
    font-weight: 600;
  }

  .social-user {
    font-size: 13px;
    color: #B5B5B5;
  }

  .texto {
    color: #E0E0E0;
  }
</style>