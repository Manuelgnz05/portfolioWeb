---
import json from "../data/experiencia.json";
import Trabajo from "./Trabajo.astro";
---

<section id="experiencia">
  <div class="experiencia-wrapper">
    <h2>EXPERIENCIA</h2>

    <div class="items-list">
      {json.map((contenido, index) => (
        <Trabajo json={contenido} isLast={index === json.length - 1} />
      ))}
    </div>
  </div>
</section>

<style>
  section {
    width: 100%;
    display: flex;
    justify-content: center;
    margin-top: 330px;
    background-color: var(--bg-main);
    transition: background-color 0.3s ease;
  }

  .experiencia-wrapper {
    width: 100%;
    max-width: 1280px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  h2 {
    font-size: 32px;
    font-weight: 700;
    color: var(--text-title);
    letter-spacing: 2px;
    margin: 0px 0px 80px 0px;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .items-list {
    display: flex;
    flex-direction: column;
    gap: 40px;
    align-items: center;
  }
</style>