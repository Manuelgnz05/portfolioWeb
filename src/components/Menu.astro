---
const navLinks = [
  { name: 'Inicio', href: '#inicio' },
  { name: 'Skills', href: '#skills' },
  { name: 'Educación', href: '#educacion' },
  { name: 'Idiomas', href: '#idiomas' },
  { name: 'Experiencia', href: '#experiencia' },
  { name: 'Proyectos', href: '#proyectos' },
  { name: 'Certificaciones', href: '#certificaciones' }
];

const socialLinks = [
  { name: 'GitHub', href: 'https://github.com/Manuelgnz05', icon: '/githudSNegro.png' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/manuel-gonz%C3%A1lez-caballero-439bb1410/', icon: '/logo_linkedin.png' }
];
---

<header class="navbar-wrapper">
  <div class="difuminado"></div>
  <div class="navbar-container">

    <a href="#inicio" class="logo-container" aria-label="Inicio">
      <img src="/logo_portfolio_sinfondo.png" alt="Logo MGC" class="logo-img" />
    </a>

    <nav class="nav-links">
      {navLinks.map((link) => (
        <a href={link.href}>{link.name}</a>
      ))}
    </nav>

    <div class="social-links">
      {socialLinks.map((social) => (
        <a href={social.href} aria-label={social.name}>
          <img src={social.icon} alt={social.name} class="social-icon" />
        </a>
      ))}
    </div>
  </div>
</header>

<style>
  .navbar-wrapper {
    position: fixed;
    top: 0px;
    width: 100%;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .difuminado{
    width: 1180px;
    height: 40px;
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
  }

  .navbar-container {
    width: 100%;
    max-width: 1180px;
    background-color: #E0E0E0;
    border: 4px solid #6A6A6A;
    border-radius: 2px;
    padding: 14px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0px 0px 50.6px rgba(0, 0, 0, 0.25);
  }

  .logo-container {
    display: flex;
    align-items: center;
  }

  .logo-img {
    height: 44px;
    width: auto;
    object-fit: contain;
  }

  .nav-links {
    display: flex;
    gap: 36px;
    align-items: center;
  }

  .nav-links a {
    text-decoration: none;
    color: #262626;
    font-size: 15px;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .social-links a {
    display: flex;
    align-items: center;
  }

  .social-icon {
    width: 22px;
    height: 22px;
    object-fit: contain;
  }
</style>