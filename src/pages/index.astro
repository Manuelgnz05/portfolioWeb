---
import Layout from '../layouts/Layout.astro';
import Menu from '../components/Menu.astro';
import Descripcion from '../components/Descripcion.astro';
import Skills from '../components/Skills.astro';
import Educacion from '../components/Educacion.astro';
import Idiomas from '../components/Idiomas.astro';
import Experiencia from '../components/Experiencia.astro';
import Proyectos from '../components/Proyectos.astro';
import Certificaciones from '../components/Certificaciones.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Menu />
  <div>
    <Descripcion />
    <Skills />
    <Educacion />
    <Idiomas/>
    <Experiencia/>
    <Proyectos/>
    <Certificaciones/>
    <Contacto/>
  </div>
    <Footer/>
</Layout>

<style>
  div{
    padding: 0px 30px 0px 30px;
  }

</style>